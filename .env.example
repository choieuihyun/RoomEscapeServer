# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다 (.gitignore 에 있다).

# DB 비밀번호. 아무 긴 문자열이면 된다:  openssl rand -base64 24
DB_PASSWORD=

# 인증서를 받을 도메인. 이 도메인의 A 레코드가 이 서버 IP 를 가리켜야 한다
DOMAIN=api.example.com

# 조회 API 를 부를 수 있는 출처. 쉼표로 여러 개.
# **보통 안 적는다** — 기본값(docker-compose.prod.yml)이 화면 주소 둘이다. 적으면 그 기본값을 통째로 덮는다 (배포.md "화면 주소 바꾸기")
# API_CORS_ORIGINS=https://choieuihyun.github.io,https://roomescapescheduler.web.app

# --- 선택 (안 적으면 기본값) ---
# 감시 API 토큰을 검증할 파이어베이스 프로젝트. 기본값이 Floduler 것이라 보통 안 건드린다
# FIREBASE_PROJECT_ID=roomescapescheduler
# 같은 자리를 다시 알리기까지의 최소 간격(분)
# NOTIFY_COOLDOWN_MINUTES=60

# --- 푸시 알림 (FCM) ---
# 켜기 전에 **키 파일을 먼저 올려 둔다.** 파일이 없는데 fcm 으로 켜면 앱이 기동에 실패한다.
#
#   1. 파이어베이스 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성" → JSON 다운로드
#   2. 그 파일을 서버의 이 디렉터리에 firebase-service-account.json 으로 올린다
#      (scp 로 올린 뒤  chmod 600 firebase-service-account.json)
#   3. 아래 두 줄의 주석을 푼다
#
# ⚠️ 이 JSON 은 **비밀번호와 같다.** 커밋 금지 (.gitignore 에 있다).
# NOTIFY_CHANNEL=fcm
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# 알림을 눌렀을 때 열 주소
# FCM_LINK=https://roomescapescheduler.web.app/

# --- 카카오 로그인 (동호회 · 배포.md "⑫ 카카오 로그인 켜기") ---
# 비워 두면 카카오 로그인만 "잠시 불가" 로 답하고 나머지는 그대로 돈다.
# 커스텀 토큰 서명에는 위 FIREBASE_CREDENTIALS_PATH 의 **같은 서비스 계정 키**를 쓴다 — 따로 올릴 것 없다.
#
# 카카오 개발자 콘솔 → [앱] → [플랫폼 키] → [REST API 키] (비밀 아님)
# KAKAO_REST_API_KEY=
# 콘솔 → [앱] → [플랫폼 키] → [REST API 키] → 클라이언트 시크릿 (카카오 로그인용). ⚠️ 비밀이다
# 2025-12 콘솔 개편 후 기본으로 켜져 있어서 **사실상 필수**다 — 빼면 카카오가 invalid_client 로 거절한다
# KAKAO_CLIENT_SECRET=
# 콘솔의 Redirect URI 와 같은 값 (쉼표로 여러 개). 기본값이 Pages + Firebase Hosting + localhost 라 보통 안 건드린다
# KAKAO_ALLOWED_REDIRECT_URIS=https://choieuihyun.github.io/RoomEscapeScheduler/,https://roomescapescheduler.web.app/,http://localhost:5173/

# --- 동호회 첫 관리자 (배포.md "⑬") ---
# ⚠️ 동호회 기능을 배포하기 **전에** 넣는다. 빈자리 알림이 승인 멤버만 걸 수 있게 바뀌어서,
#    관리자가 0명이면 아무도 승인을 못 하고 아무도 알림을 못 건다.
# 값: 파이어베이스 콘솔 → Authentication → 사용자 → 본인 계정의 "사용자 UID"
# CLUB_BOOTSTRAP_ADMIN_UID=
