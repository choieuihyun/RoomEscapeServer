# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다 (.gitignore 에 있다).

# DB 비밀번호. 아무 긴 문자열이면 된다:  openssl rand -base64 24
DB_PASSWORD=

# 인증서를 받을 도메인. 이 도메인의 A 레코드가 이 서버 IP 를 가리켜야 한다
DOMAIN=api.example.com

# 조회 API 를 부를 수 있는 출처. 쉼표로 여러 개
API_CORS_ORIGINS=https://choieuihyun.github.io

# --- 선택 (안 적으면 기본값) ---
# 감시 API 토큰을 검증할 파이어베이스 프로젝트. 기본값이 Floduler 것이라 보통 안 건드린다
# FIREBASE_PROJECT_ID=roomescapescheduler
# 같은 자리를 다시 알리기까지의 최소 간격(분)
# NOTIFY_COOLDOWN_MINUTES=60

# --- 푸시 알림 (FCM) ---
# 켜기 전에 **키 파일을 먼저 올려 둔다.** 파일이 없는데 fcm 으로 켜면 앱이 기동에 실패한다.
#
#   1. 파이어베이스 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성" → JSON 다운로드
#   2. 그 파일을 서버의 이 디렉터리에 firebase-service-account.json 으로 올린다
#      (scp 로 올린 뒤  chmod 600 firebase-service-account.json)
#   3. 아래 두 줄의 주석을 푼다
#
# ⚠️ 이 JSON 은 **비밀번호와 같다.** 커밋 금지 (.gitignore 에 있다).
# NOTIFY_CHANNEL=fcm
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# 알림을 눌렀을 때 열 주소
# FCM_LINK=https://choieuihyun.github.io/RoomEscapeScheduler/
