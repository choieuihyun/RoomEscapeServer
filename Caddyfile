# 도메인만 있으면 Let's Encrypt 인증서를 알아서 받고 갱신한다.
{$DOMAIN} {
	encode zstd gzip

	# 밖으로 내보내는 것은 /api 뿐이다 — 조회(공개)와 감시(로그인 필요).
	# 로그인 검사는 앱이 한다. Caddy 는 어느 경로를 통과시킬지만 정한다.
	handle /api/* {
		reverse_proxy app:8080
	}

	# ⚠️ 여기 블록이 `{$DOMAIN}` 하나뿐이라 **`Host: localhost` 로 오는 요청에는 안 답한다.**
	# 그래서 bootstrap 과 autodeploy 의 확인 단계가 `curl --resolve` 로 도메인을 흉내낸다 —
	# 그냥 `curl localhost` 로 바꾸면 앱이 멀쩡해도 배포가 실패한 것처럼 보인다.

	# /debug 를 비롯한 나머지는 앱까지 가지도 않는다.
	# 앱 쪽에서도 DEBUG_ENDPOINTS=false 로 꺼 두지만, 둘 다 걸어 둔다.
	handle {
		respond "Not Found" 404
	}
}
